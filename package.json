{
  "name": "f95-tinder",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @f95/api --filter @f95/web dev",
    "dev:api": "pnpm --filter @f95/api dev",
    "dev:web": "pnpm --filter @f95/web dev",
    "build": "pnpm --recursive --if-present build",
    "build:api": "pnpm --filter @f95/api build",
    "build:web": "pnpm --filter @f95/web build"
  }
}
