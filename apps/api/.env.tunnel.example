# SSH-подключение
SSH_HOST= # Адрес SSH-сервера; укажите IP, домен или алиас из SSH-конфигурации.
SSH_USER=bisky # Пользователь SSH; укажите аккаунт с доступом к Docker на сервере.

# Удалённые Docker-контейнеры
MONGO_CONTAINER= # Имя контейнера MongoDB; возьмите из `docker ps` на SSH-сервере.
REDIS_CONTAINER= # Имя контейнера Redis; возьмите из `docker ps` на SSH-сервере.

# Локальные порты туннелей
MONGO_LOCAL_PORT=27018 # Локальный порт MongoDB; выберите свободный порт для перенаправления на порт 27017 контейнера.
REDIS_LOCAL_PORT=6380 # Локальный порт Redis; выберите свободный порт, отличный от MONGO_LOCAL_PORT, для перенаправления на порт 6379 контейнера.
