{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "incremental": false,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "@entities/*": ["entities/*"],
      "@endpoints/*": ["endpoints/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@shared/*": ["shared/*"],
      "@test/*": ["tests/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
