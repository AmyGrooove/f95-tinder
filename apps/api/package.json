    "@keyv/redis": "5.1.6",
    "@nestjs-redis/client": "2.0.1",
    "@nestjs-redis/throttler-storage": "2.0.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/cache-manager": "12.0.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/http-client": "0.0.2",
    "@nestjs/jwt": "12.0.3",
