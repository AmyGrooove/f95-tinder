# Приложение
NODE_ENV=development # Среда API; используйте development для локальной разработки.
APP_NAME=bisky # Имя API; задайте имя проекта.
APP_VERSION=1.0.0 # Версия API; возьмите из версии релиза проекта.
APP_DESCRIPTION=Bisky API # Описание API; задайте текст для Swagger.
PORT=3000 # HTTP-порт API; выберите свободный локальный порт.

# CORS
CORS_ORIGINS=http://localhost:3001 # Разрешённые источники CORS; укажите URL локального Web.

# Базы данных и кеш
MONGO_URL=mongodb://localhost:27017/bisky # Строка подключения MongoDB; получите из локального MongoDB или облака.
REDIS_URL=redis://localhost:6379/0 # Строка подключения Redis; получите из локального Redis или облака.

# Аутентификация
JWT_ACCESS_SECRET=replace-with-a-unique-secret-of-at-least-32-characters # Секрет access JWT; сгенерируйте не менее 32 случайных символов.
JWT_REFRESH_SECRET=replace-with-a-different-secret-of-at-least-32-characters # Секрет refresh JWT; сгенерируйте другой секрет не менее 32 символов.

# Объектное хранилище Garage
GARAGE_URL=http://localhost:3900 # S3 API Garage; для локального экземпляра используйте порт из garage.toml.
GARAGE_REGION=garage # S3 region Garage; значение должно совпадать с s3_region в garage.toml.
GARAGE_ACCESS_KEY_ID=replace-with-garage-key-id # Key ID Garage; получите через `garage key create`.
GARAGE_SECRET_ACCESS_KEY=replace-with-garage-secret-key # Secret key Garage; сохраните из вывода `garage key create`.
GARAGE_PUBLIC_URL=http://bisky.web.garage.localhost:3902 # Публичная база bucket bisky; настройте s3_web и разрешите website access.

# Поиск Meilisearch
MEILISEARCH_URL=http://localhost:7700 # URL Meilisearch; укажите адрес локального сервиса или облака.
MEILISEARCH_ACCESS_SECRET=replace-with-meilisearch-access-secret # Master key Meilisearch; возьмите из настроек сервиса.

# Почта Resend
RESEND_ACCESS_SECRET=replace-with-resend-access-secret # API-ключ Resend; создайте в настройках API Keys.
MAIL_DOMAIN=example.com # Домен отправителя; подтвердите его в Resend.
