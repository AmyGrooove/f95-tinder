# Приложение
NODE_ENV=development # Среда API; используйте development для локальной разработки.
APP_NAME=bisky # Имя API; задайте имя проекта.
APP_VERSION=1.0.0 # Версия API; возьмите из версии релиза проекта.
APP_DESCRIPTION=Bisky API # Описание API; задайте текст для Swagger.
PORT=3000 # HTTP-порт API; выберите свободный локальный порт.

# CORS
CORS_ORIGINS=http://localhost:3001 # Разрешённые источники CORS; укажите URL локального Web.

# Базы данных и кеш
MONGO_URL=mongodb://localhost:27017/bisky # Строка подключения MongoDB; получите из локального MongoDB или облака.
REDIS_URL=redis://localhost:6379/0 # Строка подключения Redis; получите из локального Redis или облака.

# Аутентификация
JWT_ACCESS_SECRET=replace-with-a-unique-secret-of-at-least-32-characters # Секрет access JWT; сгенерируйте не менее 32 случайных символов.
JWT_REFRESH_SECRET=replace-with-a-different-secret-of-at-least-32-characters # Секрет refresh JWT; сгенерируйте другой секрет не менее 32 символов.

# Объектное хранилище MinIO
MINIO_URL=http://localhost:9000 # Внутренний URL MinIO; укажите адрес S3-совместимого хранилища.
MINIO_ACCESS_KEY=replace-with-minio-access-key # Access key MinIO; возьмите из настроек хранилища.
MINIO_ACCESS_SECRET=replace-with-minio-access-secret # Secret key MinIO; возьмите из настроек хранилища.
MINIO_PUBLIC_URL=http://localhost:9000/bisky # Публичный URL MinIO; укажите адрес, доступный браузерам.

# Поиск Meilisearch
MEILISEARCH_URL=http://localhost:7700 # URL Meilisearch; укажите адрес локального сервиса или облака.
MEILISEARCH_ACCESS_SECRET=replace-with-meilisearch-access-secret # Master key Meilisearch; возьмите из настроек сервиса.

# Почта SMTP
MAIL_DOMAIN=example.com # Домен отправителя; подтвердите его у SMTP-провайдера.
SMTP_HOST=localhost # SMTP-хост; возьмите из настроек почтового сервера.
SMTP_PORT=587 # SMTP-порт; возьмите из настроек почтового сервера.
SMTP_SECURE=false # Использование TLS SMTP; возьмите из настроек почтового сервера.
SMTP_USER=replace-with-smtp-user # SMTP-пользователь; возьмите из SMTP Credential.
SMTP_PASSWORD=replace-with-smtp-password # SMTP-пароль; возьмите из SMTP Credential.

# Наблюдаемость OpenObserve
OPENOBSERVE_USERNAME=root@example.com # Администратор OpenObserve; возьмите из локальной конфигурации.
OPENOBSERVE_PASSWORD=replace-with-a-strong-openobserve-password # Пароль OpenObserve; задайте при первом запуске OpenObserve.
OPENOBSERVE_URL=http://localhost:5080/api/default/bisky/_json # URL ingestion OpenObserve; укажите stream API проекта.
