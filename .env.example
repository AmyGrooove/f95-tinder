# CORS
CORS_ORIGINS=http://localhost:3001 # Разрешённые источники CORS; укажите публичный URL Web.

# Базы данных и кеш
MONGO_PASSWORD=change-me-mongo # Пароль MongoDB; сгенерируйте криптографически стойкое значение.
REDIS_PASSWORD=change-me-redis # Пароль Redis; сгенерируйте криптографически стойкое значение.

# Аутентификация
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters # Секрет access JWT; сгенерируйте не менее 32 случайных символов.
JWT_REFRESH_SECRET=replace-with-a-different-32-random-characters # Секрет refresh JWT; сгенерируйте другой секрет не менее 32 символов.

# Объектное хранилище MinIO
MINIO_ACCESS_KEY=change-me-minio-user # Access key MinIO; задайте уникальное имя пользователя хранилища.
MINIO_ACCESS_SECRET=change-me-minio-password # Secret key MinIO; сгенерируйте криптографически стойкое значение.
MINIO_PUBLIC_URL=http://localhost:9000/bisky # Публичный URL MinIO; укажите адрес, доступный клиентам API.
MINIO_BIND_ADDRESS=0.0.0.0 # Адрес публикации S3 API; измените для ограничения сетевого доступа.
MINIO_PORT=9000 # Внешний порт S3 API; измените при конфликте порта.
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1 # Адрес публикации MinIO Console; ограничьте localhost в production.
MINIO_CONSOLE_PORT=9001 # Внешний порт MinIO Console; измените при конфликте порта.

# Поиск Meilisearch
MEILISEARCH_ACCESS_SECRET=change-me-meilisearch-master-key # Master key Meilisearch; сгенерируйте криптографически стойкое значение.
MEILISEARCH_BIND_ADDRESS=127.0.0.1 # Адрес публикации Meilisearch; ограничьте localhost в production.
MEILISEARCH_PORT=7700 # Внешний порт Meilisearch; измените при конфликте порта.

# Почта Postal
MAIL_DOMAIN=example.com # Домен отправителя; подтвердите его в Postal.
POSTAL_HOSTNAME=postal.example.com # Публичное имя Postal; укажите DNS-имя почтового сервера.
POSTAL_WEB_PROTOCOL=https # Протокол публичного Postal; укажите https за TLS-прокси.
POSTAL_DB_PASSWORD=change-me-postal-db # Пароль MariaDB Postal; сгенерируйте криптографически стойкое значение.
POSTAL_RAILS_SECRET=replace-with-a-long-random-secret # Секрет Rails Postal; сгенерируйте длинную случайную строку.
POSTAL_WEB_BIND_ADDRESS=127.0.0.1 # Адрес публикации Postal Web; ограничьте localhost в production.
POSTAL_WEB_PORT=5000 # Внешний порт Postal Web; измените при конфликте порта.
POSTAL_SMTP_BIND_ADDRESS=0.0.0.0 # Адрес публикации SMTP Postal; укажите 0.0.0.0 для внешней доставки.
POSTAL_SMTP_PORT=25 # Внешний SMTP-порт Postal; измените при конфликте порта.
SMTP_USER=replace-after-postal-setup # SMTP-пользователь API; создайте Credential в Postal.
SMTP_PASSWORD=replace-after-postal-setup # SMTP-пароль API; скопируйте пароль созданного Credential в Postal.

# Наблюдаемость OpenObserve
OPENOBSERVE_USERNAME=root@example.com # Email администратора OpenObserve; задайте учётную запись администратора.
OPENOBSERVE_PASSWORD=change-me-openobserve # Пароль OpenObserve; сгенерируйте криптографически стойкое значение.
OPENOBSERVE_BIND_ADDRESS=127.0.0.1 # Адрес публикации OpenObserve; ограничьте localhost в production.
OPENOBSERVE_PORT=5080 # Внешний порт OpenObserve; измените при конфликте порта.

# Публикация приложений
API_BIND_ADDRESS=0.0.0.0 # Адрес публикации API; измените для ограничения сетевого доступа.
API_PORT=3000 # Внешний порт API; измените при конфликте порта.
WEB_BIND_ADDRESS=0.0.0.0 # Адрес публикации Web; измените для ограничения сетевого доступа.
WEB_PORT=3001 # Внешний порт Web; измените при конфликте порта.
